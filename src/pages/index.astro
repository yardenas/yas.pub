---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import { getNews } from '~/utils/news';
import { astroAsseetsOptimizer, getImagesOptimized } from '~/utils/images-optimization';
import heroImage from '~/assets/images/hero-2025.png';

const recentNews = await getNews();
const siteUrl = Astro.site ? Astro.site.toString() : 'https://yas.pub';
const heroImageUrl = Astro.site ? new URL(heroImage.src, Astro.site).toString() : heroImage.src;
const heroImageProps = {
  src: heroImage,
  alt: 'Yasos!',
  width: 275,
  height: 275,
  widths: [400, 768, 1024, 2040],
  sizes: '(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px',
  loading: 'eager',
  fetchpriority: 'high',
};
const heroImagePreload = await getImagesOptimized(heroImage, heroImageProps, astroAsseetsOptimizer);
const heroImagePreloadSrcset = heroImagePreload.attributes.srcset;
const heroImagePreloadHref = heroImagePreloadSrcset
  ? heroImagePreloadSrcset.split(',')[0].trim().split(' ')[0]
  : heroImagePreload.src;
const personStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}#person`,
  name: 'Yarden As',
  url: siteUrl,
  image: {
    '@type': 'ImageObject',
    url: heroImageUrl,
    width: heroImage.width,
    height: heroImage.height,
  },
  jobTitle: 'PhD candidate in Robotics and AI',
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'ETH Zürich',
  },
  sameAs: [
    'https://twitter.com/yarden_as',
    'https://www.linkedin.com/in/yardenas/',
    'https://scholar.google.com/citations?user=Z0qGI_kAAAAJ&hl=en',
  ],
  knowsAbout: ['robotics', 'reinforcement learning', 'online learning'],
  description: 'Roboticist and researcher focusing on online reinforcement learning and safe exploration.',
};

const metadata = {
  title: 'Yarden As 🎶',
  ignoreTitleTemplate: true,
};

const publicationTopics = [
  {
    name: 'Reinforcement learning',
    papers: [
      {
        number: 1,
        title: 'Constrained Policy Optimization via Bayesian World Models',
        href: 'https://arxiv.org/abs/2201.09802',
      },
      {
        number: 2,
        title: 'Data-Efficient Task Generalization via Probabilistic Model-based Meta Reinforcement Learning',
        href: 'https://arxiv.org/abs/2311.07558',
      },
      {
        number: 3,
        title: 'When to Sense and Control? A Time-adaptive Approach for Continuous-Time RL',
        href: 'https://arxiv.org/abs/2406.01163',
      },
      {
        number: 4,
        title: 'When Does Non-Uniform Replay Matter in Reinforcement Learning?',
        href: 'https://arxiv.org/abs/2605.10236',
      },
    ],
  },
  {
    name: 'Safe exploration',
    papers: [
      {
        number: 5,
        title: 'ActSafe: Active Exploration with Safety Constraints for Reinforcement Learning',
        href: 'https://arxiv.org/abs/2410.09486',
      },
      {
        number: 6,
        title: 'Safe Exploration via Policy Priors',
        href: 'https://arxiv.org/abs/2601.19612',
      },
      {
        number: 7,
        title: 'Sampling-Based Safe Reinforcement Learning',
        href: 'https://arxiv.org/abs/2605.19469',
      },
    ],
  },
  {
    name: 'Sim-to-real',
    papers: [
      {
        number: 8,
        title: 'What Matters for Simulation to Online Reinforcement Learning on Real Robots',
        href: 'https://arxiv.org/abs/2602.20220',
      },
      {
        number: 9,
        title: 'SPiDR: A Simple Approach for Zero-Shot Safety in Sim-to-Real Transfer',
        href: 'https://arxiv.org/abs/2509.18648',
      },
    ],
  },
  {
    name: 'Stochastic optimization',
    papers: [
      {
        number: 10,
        title: 'Log Barriers for Safe Black-box Optimization with Application to Safe Reinforcement Learning',
        href: 'https://arxiv.org/abs/2207.10415',
      },
      {
        number: 11,
        title: 'Safe-EF: Error Feedback for Nonsmooth Constrained Optimization',
        href: 'https://arxiv.org/abs/2505.06053',
      },
    ],
  },
] as const;
---

<Layout metadata={metadata} bg-color="--aw-color-bg-page">
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={heroImagePreloadHref}
      imagesrcset={heroImagePreload.attributes.srcset}
      imagesizes={heroImagePreload.attributes.sizes}
    />
    <script type="application/ld+json" set:html={JSON.stringify(personStructuredData)} />
  </Fragment>
  <Fragment slot="header"> </Fragment>
  <Hero image={heroImageProps}>
    <Fragment slot="title">
      <span class="font-mono">Yarden As</span>
    </Fragment>
    <Fragment slot="subtitle">
      <span class="font-mono">[ y ah r Den ]</span>
      <br /><span class="font-serif-heb text-2xl">ירדן</span>
    </Fragment>
    <Fragment slot="content">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
        <div class="space-y-4">
          <h3 class="text-2xl font-bold tracking-tight sm:text-3xl">About me</h3>
          <p class="text-sm">
            I am a roboticist, now pursuing a PhD in artificial intelligence and robotics, advised by <a
              href="https://las.inf.ethz.ch/krausea/"
              class="a-link"
              target="_blank">Andreas Krause</a
            >. My research focuses on online reinforcement learning, reinforcement learning under constraints and on
            exploration.
          </p>
          <p class="text-sm">
            Beyond research, I co-founded <a href="https://obol.app" class="a-link">Obol</a> and worked as a principal robotics
            engineer at Temi Robotics. I hold a Master's degree in robotics from ETH Zürich and graduated summa cum laude
            from Technion.
          </p>
          <h3 class="text-2xl font-bold tracking-tight sm:text-3xl">Research</h3>
          <div class="space-y-2 text-sm">
            <ul class="list-disc space-y-1 pl-5 leading-relaxed">
              {
                publicationTopics.map((topic) => (
                  <li>
                    {topic.name}{' '}
                    <span class="inline-flex items-baseline whitespace-nowrap">
                      {'['}
                      {topic.papers.map((paper, index) => (
                        <Fragment>
                          <a
                            href={paper.href}
                            class="a-link inline-flex"
                            aria-label={`Paper ${paper.number}: ${paper.title}`}
                            title={paper.title}
                          >
                            {paper.number}
                          </a>
                          {index < topic.papers.length - 1 ? ',\u00a0' : ''}
                        </Fragment>
                      ))}
                      {']'}
                    </span>
                  </li>
                ))
              }
            </ul>
            <p>
              A full list of my publications can be found <a
                href="https://scholar.google.com/citations?user=Z0qGI_kAAAAJ&hl=en"
                class="a-link">here</a
              >.
            </p>
          </div>
        </div>
        <div class="space-y-4">
          <h3 class="text-2xl font-bold tracking-tight sm:text-3xl">Recent news</h3>
          <ul class="max-h-96 space-y-3 overflow-y-scroll pr-2 text-sm no-scrollbar md:max-h-[17rem]">
            {
              recentNews.map((item) => {
                const NewsContent = item.Content;
                const hasContent = item.content?.trim();

                return (
                  <li class="news-item">
                    <span class="font-bold">
                      {item.publishDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      })}
                    </span>
                    <br />
                    {hasContent && NewsContent ? (
                      <div class="news-content">
                        <NewsContent />
                      </div>
                    ) : (
                      item.title
                    )}
                  </li>
                );
              })
            }
          </ul>
          <h3 class="text-2xl font-bold tracking-tight sm:text-3xl">Reaching out</h3>
          <ul class="list-disc list-inside text-sm leading-tight">
            <li>Email via yardas strudel ethz punkt ch</li>
            <li>
              <a href="https://twitter.com/yarden_as" class="a-link" target="_blank">Twitter</a>
            </li>
            <li>
              <a href="https://www.linkedin.com/in/yardenas/" class="a-link" target="_blank">Linkedin</a>
            </li>
          </ul>
        </div>
      </div>
    </Fragment>
  </Hero>
</Layout>

<style>
  * {
    font-family: var(--aw-font-mono);
  }
  .no-scrollbar {
    scrollbar-width: thin; /* Firefox */
    scrollbar-color: #aaa #fff; /* thumb color | track color */
  }

  .no-scrollbar::-webkit-scrollbar {
    width: 6px; /* make scrollbar thin */
  }

  .no-scrollbar::-webkit-scrollbar-track {
    background: transparent; /* no background */
  }

  .no-scrollbar::-webkit-scrollbar-thumb {
    background-color: #aaa; /* subtle gray thumb */
    border-radius: 9999px; /* fully rounded */
  }

  .news-content :global(p) {
    display: inline;
    margin: 0;
  }

  .news-content :global(a) {
    color: var(--aw-color-primary);
  }

  .news-content :global(a:hover) {
    text-decoration: underline;
  }
</style>
